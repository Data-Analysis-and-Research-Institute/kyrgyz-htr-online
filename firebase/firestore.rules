rules_version = '2';
// Firestore security rules for the handwriting collection and validation (paste into Firebase console ->
// Firestore Database -> Rules, or deploy with the Firebase CLI).
//  * contributors sign in anonymously and can only CREATE their own consent record and samples
//  * anyone signed in with Google is a validator (no approval step). Validators can read samples and all
//    reviews, and write one review (vote) per sample; a label needs at least 2 agreeing votes.
//    Anonymous (contributor) accounts cannot read anything.
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidator() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    match /consents/{uid} {
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.consent_version is string
        && request.resource.data.agreed == true
        && request.resource.data.age_16_plus == true;
      allow read, delete: if false;
    }

    match /submissions/{id} {
      allow create: if request.auth != null
        && request.resource.data.writer_id == request.auth.uid
        && exists(/databases/$(database)/documents/consents/$(request.auth.uid))
        && request.resource.data.text is string && request.resource.data.text.size() <= 64
        && request.resource.data.prompt_id is string
        && request.resource.data.png is string && request.resource.data.png.size() < 900000
        && request.resource.data.strokes is string && request.resource.data.strokes.size() < 400000;
      allow read: if isValidator();
      allow update, delete: if false;
    }

    // one review per (sample, validator): document id = "<submission id>_<validator uid>"
    match /reviews/{rid} {
      allow read: if isValidator();
      allow create, update: if isValidator()
        && request.resource.data.validator_uid == request.auth.uid
        && rid == request.resource.data.submission_id + '_' + request.auth.uid
        && request.resource.data.verdict in ['correct', 'wrong_label', 'illegible', 'not_kyrgyz', 'personal_info']
        && request.resource.data.corrected_text is string && request.resource.data.corrected_text.size() <= 64;
      allow delete: if false;
    }
  }
}
